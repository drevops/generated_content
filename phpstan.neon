##
# Configuration file for PHPStan static code checking, see https://phpstan.org .
#
# Note that drupal-specific rules are automatically included by phpstan/extension-installer
# from vendor/mglaman/phpstan-drupal/extension.neon and vendor/mglaman/phpstan-drupal/rules.neon
# @see https://github.com/mglaman/phpstan-drupal
#
# Paths are declared in the `paths` key below, not passed as CLI
# arguments.

parameters:

  level: 7

  # PHPStan caches reflection data that embeds absolute paths into its own
  # PHAR. The default cache directory is shared by every project on the machine,
  # so entries left by a build that no longer exists break the next run. Keeping
  # the cache beside this config scopes it to a single codebase.
  tmpDir: .phpstan

  paths:
    - web/modules/custom

  excludePaths:
    - vendor/*
    - node_modules/*
    - ../*/node_modules/*

  ignoreErrors:
    -
      # Hook implementation docblocks carry only 'Implements hook_NAME().', so
      # they declare neither iterable value types nor return types.
      messages:
        - '#.* no value type specified in iterable type array#'
        - '#.* has no return type specified#'
      reportUnmatched: false
    -
      # PHP resolves attribute classes lazily and PHPUnit 9.6 reads doc-comment
      # metadata, so these are inert rather than broken on a Drupal 10 build.
      # Rector writes them from the Drupal 11 set.
      messages:
        - '#^Attribute class PHPUnit\\Framework\\Attributes\\.+ does not exist\.$#'
      reportUnmatched: false
    -
      # @SuppressWarnings(PHPMD.*) is valid PHPMD annotation syntax that
      # PHPStan's PHPDoc parser does not recognise.
      message: '#PHPDoc tag @SuppressWarnings has invalid value#'
      reportUnmatched: false
    -
      # Defensive runtime assertions on values whose static type is already
      # known. The redundancy is intentional - it guards against unexpected
      # input at runtime.
      messages:
        - '#Call to method PHPUnit\\Framework\\Assert::assert\w+\(\) with .* will always evaluate to true#'
        - '#Call to function is_callable\(\) with .* will always evaluate to true#'
      reportUnmatched: false

  reportUnmatchedIgnoredErrors: false
